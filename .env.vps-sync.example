# Configuração do sync VPS → DEV local
# Copie este arquivo para .env.vps-sync e preencha os valores reais.
# .env.vps-sync está no .gitignore e nunca será commitado.
#
# Uso: npm run db:sync-from-vps

# SSH
VPS_SSH_USER=root
VPS_SSH_HOST=143.95.161.39
VPS_SSH_PORT=22022

# PostgreSQL (dentro do Docker na VPS)
VPS_PG_INTERNAL_IP=172.18.0.2
VPS_PG_USER=cs2stats
VPS_PG_PASSWORD=cs2stats
VPS_PG_DB=cs2stats
