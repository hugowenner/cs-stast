{
  "name": "cs2-stats",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3210",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill-seasons": "tsx src/server/admin/backfill-match-seasons.ts",
    "db:studio": "prisma studio",
    "db:migrate-to-postgres": "tsx scripts/migrate-to-postgres.ts",
    "db:sync-from-vps": "powershell -ExecutionPolicy Bypass -File scripts/sync-db-from-vps.ps1",
    "db:sync-pg": "tsx scripts/sync-from-vps-to-pg.ts",
    "db:sync-from-neon": "powershell -ExecutionPolicy Bypass -File scripts/sync-from-neon.ps1",
    "db:sync-from-neon:import": "powershell -ExecutionPolicy Bypass -File scripts/sync-from-neon.ps1 -Import",
    "db:sync-pg-neon": "tsx scripts/sync-from-neon-to-dev.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node scripts/demo/run-demo.mjs",
    "empty-demo": "node scripts/demo/run-demo.mjs --empty",
    "demo:snapshot": "node scripts/demo/snapshot-demo.mjs",
    "reset-demo": "node scripts/demo/reset-demo.mjs",
    "season:test-rollover": "tsx scripts/test-season-rollover.ts",
    "season:repair": "tsx scripts/repair-seasons.ts",
    "audit:match-dates": "tsx scripts/audit-match-dates.ts",
    "audit:player-names": "tsx scripts/audit-player-names.ts",
    "fix:player-names": "tsx scripts/fix-player-names.ts",
    "audit:season-stats": "tsx scripts/audit-season-stats.ts",
    "audit:system-integrity": "tsx scripts/audit-system-integrity.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@tanstack/react-query": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.9.2",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.10",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
