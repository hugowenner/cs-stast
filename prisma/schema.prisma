generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Player {
  id                 String              @id @default(cuid())
  steamId            String              @unique
  nickname           String
  avatarUrl          String?
  gamersClubId       String?             @unique
  levelGc            Int?
  createdAt          DateTime            @default(now())
  steamNickname      String?
  steamAvatarSmall   String?
  steamAvatarMedium  String?
  steamAvatarFull    String?
  steamProfileUrl    String?
  steamLastSync      DateTime?
  events             Event[]             @relation("EventActor")
  eventsAsVictim     Event[]             @relation("EventVictim")
  achievements       PlayerAchievement[]
  clutches           PlayerClutch[]
  entryDuels         PlayerEntryDuel[]
  matchStats         PlayerMatchStats[]
  matchupsAsKiller   PlayerMatchup[]     @relation("MatchupKiller")
  matchupsAsVictim   PlayerMatchup[]     @relation("MatchupVictim")
  tradesAsTrader     PlayerTradeEvent[]  @relation("TradeTrader")
  tradesAsVictim     PlayerTradeEvent[]  @relation("TradeVictim")
  rivalriesAsA       Rivalry[]           @relation("RivalryPlayerA")
  rivalriesAsB       Rivalry[]           @relation("RivalryPlayerB")
  user               User?
  teamBalancePlayers TeamBalancePlayer[]
  trackedPlayer      TrackedPlayer?
}

/// Reservado para autenticação na Fase 2. Sem fluxo de login no MVP.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  playerId  String?  @unique
  createdAt DateTime @default(now())
  player    Player?  @relation(fields: [playerId], references: [id])
}

/// Agregado raiz de uma noite de jogo (ex: "Mix de Quinta").
model Session {
  id        String   @id @default(cuid())
  name      String
  date      DateTime
  createdAt DateTime @default(now())
  matches   Match[]
}

model Map {
  id       String  @id @default(cuid())
  name     String  @unique
  imageUrl String?
  matches  Match[]
}

model Match {
  id                  String              @id @default(cuid())
  sessionId           String
  mapId               String
  gamersClubMatchId   String?             @unique
  playedAt            DateTime
  scoreTeamA          Int
  scoreTeamB          Int
  durationSeconds     Int
  demoUrl             String?
  roundsJson          Json?
  /// Quantos jogadores monitorados (TrackedPlayer.active = true) participaram desta
  /// partida, calculado uma vez na ingestão (src/server/services/match.service.ts) e
  /// nunca recalculado depois. Fonte de verdade da classificação SOLO (< 2) vs
  /// COMUNIDADE (>= 2) — ver src/server/domain/matchClassification.ts. Guardado como
  /// contagem (não como enum) para permitir métricas futuras mais granulares (ex.:
  /// Rating Solo x Equipe) sem precisar de outra migration.
  trackedPlayersCount Int                 @default(0)
  seasonId            String?
  events              Event[]
  map                 Map                 @relation(fields: [mapId], references: [id])
  season              Season?             @relation(fields: [seasonId], references: [id])
  session             Session             @relation(fields: [sessionId], references: [id])
  achievements        PlayerAchievement[]
  clutches            PlayerClutch[]
  entryDuels          PlayerEntryDuel[]
  playerStats         PlayerMatchStats[]
  matchups            PlayerMatchup[]
  trades              PlayerTradeEvent[]
  demoProjections     DemoMatchProjection[]

  @@index([sessionId])
  @@index([playedAt])
  @@index([trackedPlayersCount])
  @@index([seasonId])
  @@index([seasonId, playedAt])
}

/// Estatísticas de um jogador em uma partida — granularidade base de todo o sistema;
/// estatísticas agregadas (winrate, performance por mapa/horário/parceiro, etc.) são
/// sempre derivadas a partir daqui, nunca armazenadas de forma redundante.
model PlayerMatchStats {
  id                String    @id @default(cuid())
  matchId           String
  playerId          String
  team              MatchTeam
  kills             Int
  deaths            Int
  assists           Int
  headshots         Int
  adr               Float
  rating            Float
  kast              Float
  impact            Float
  damage            Int?
  gcRating          Float?
  doubleKills       Int?
  tripleKills       Int?
  quadKills         Int?
  aces              Int?
  entryKills        Int
  entryDeaths       Int
  tradeKills        Int
  clutchesWon       Int       @default(0)
  flashAssists      Int       @default(0)
  clutch1v1Attempts Int       @default(0)
  clutch1v1Wins     Int       @default(0)
  clutch1v2Attempts Int       @default(0)
  clutch1v2Wins     Int       @default(0)
  clutch1v3Attempts Int       @default(0)
  clutch1v3Wins     Int       @default(0)
  clutch1v4Attempts Int       @default(0)
  clutch1v4Wins     Int       @default(0)
  clutch1v5Attempts Int       @default(0)
  clutch1v5Wins     Int       @default(0)
  levelGc           Int?
  eloBefore         Int
  eloAfter          Int
  match             Match     @relation(fields: [matchId], references: [id])
  player            Player    @relation(fields: [playerId], references: [id])

  @@unique([matchId, playerId])
  @@index([playerId])
  @@index([matchId])
}

/// Catálogo de conquistas. Definido em código/seed, não editável via UI no MVP.
model Achievement {
  id                 String              @id @default(cuid())
  code               String              @unique
  name               String
  description        String
  iconUrl            String?
  tier               String
  playerAchievements PlayerAchievement[]
}

/// Registro de conquista obtida. Conquistas por partida usam matchId; conquistas
/// cumulativas (ex: "1000 kills") usam matchId = null e devem ser únicas por jogador —
/// a unicidade do caso matchId nulo é garantida por um índice parcial adicionado
/// manualmente na migration (Postgres trata NULL como distinto em @@unique comum),
/// não pelo constraint abaixo.
model PlayerAchievement {
  id            String      @id @default(cuid())
  playerId      String
  achievementId String
  matchId       String?
  earnedAt      DateTime    @default(now())
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  match         Match?      @relation(fields: [matchId], references: [id])
  player        Player      @relation(fields: [playerId], references: [id])

  @@unique([playerId, achievementId, matchId])
  @@index([playerId])
}

/// Head-to-head agregado entre dois jogadores. Por convenção de aplicação, playerAId
/// é sempre o menor id (ordenação lexicográfica) para evitar registros duplicados
/// invertidos — responsabilidade do RivalryEngine, não do banco.
model Rivalry {
  id              String   @id @default(cuid())
  playerAId       String
  playerBId       String
  seasonId        String?
  killsAOnB       Int      @default(0)
  killsBOnA       Int      @default(0)
  matchesTogether Int      @default(0)
  matchesAgainst  Int      @default(0)
  updatedAt       DateTime @updatedAt
  playerA         Player   @relation("RivalryPlayerA", fields: [playerAId], references: [id])
  playerB         Player   @relation("RivalryPlayerB", fields: [playerBId], references: [id])
  season          Season?  @relation(fields: [seasonId], references: [id])

  @@unique([playerAId, playerBId, seasonId])
}

/// Evento de uma partida. `KILL` carrega `victimId` e alimenta o RivalryEngine
/// (head-to-head por par de jogadores); os demais tipos são eventos notáveis que
/// alimentam feed/highlights e disparam o AchievementEngine.
model Event {
  id          String    @id @default(cuid())
  matchId     String
  playerId    String
  victimId    String?
  type        EventType
  roundNumber Int
  metadata    Json?
  createdAt   DateTime  @default(now())
  match       Match     @relation(fields: [matchId], references: [id])
  player      Player    @relation("EventActor", fields: [playerId], references: [id])
  victim      Player?   @relation("EventVictim", fields: [victimId], references: [id])

  @@index([matchId])
  @@index([playerId])
  @@index([victimId])
}

/// Log de cada execução de sincronização. Guarda o payload bruto recebido do provedor
/// (ex: JSON original da Gamers Club) além do resultado — permite reprocessar,
/// recalcular estatísticas/conquistas/ELO ou depurar sem precisar de uma nova
/// sincronização, e sobrevive a mudanças futuras no formato do provedor.
model Import {
  id              String       @id @default(cuid())
  source          String
  providerVersion Int          @default(1)
  rawPayload      Json?
  status          ImportStatus @default(PENDING)
  startedAt       DateTime     @default(now())
  finishedAt      DateTime?
  matchesImported Int          @default(0)
  errorMessage    String?
}

model Log {
  id        String   @id @default(cuid())
  level     LogLevel
  message   String
  context   Json?
  createdAt DateTime @default(now())

  @@index([level])
  @@index([createdAt])
}

/// Chave/valor para parâmetros de sistema (K-factor do ELO, ID do grupo Gamers Club, thresholds).
model Configuration {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model TrackedPlayer {
  id           String   @id @default(cuid())
  gamersClubId String   @unique @map("gamersclub_id")
  active       Boolean  @default(true)
  nickname     String?
  createdAt    DateTime @default(now()) @map("created_at")
  playerId     String?  @unique @map("player_id")
  player       Player?  @relation(fields: [playerId], references: [id])

  @@map("tracked_players")
}

model Season {
  id        String          @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  status    SeasonStatus    @default(ACTIVE)
  createdAt DateTime        @default(now())
  matches   Match[]
  rivalries Rivalry[]
  snapshots SeasonSnapshot?

  @@index([status])
  @@index([startDate, endDate])
}

model SeasonSnapshot {
  id        String   @id @default(cuid())
  seasonId  String   @unique
  dashboard Json
  createdAt DateTime @default(now())
  season    Season   @relation(fields: [seasonId], references: [id])
}

model TeamBalanceMatch {
  id         String              @id @default(cuid())
  seed       String
  mode       String
  metric     String
  difference Float
  winner     String?
  createdAt  DateTime            @default(now())
  players    TeamBalancePlayer[]

  @@index([createdAt])
  @@index([seed])
}

model TeamBalancePlayer {
  id       String           @id @default(cuid())
  matchId  String           @map("match_id")
  playerId String?          @map("player_id")
  nickname String
  avatar   String?
  team     String
  weight   Float
  guest    Boolean          @default(false)
  match    TeamBalanceMatch @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player   Player?          @relation(fields: [playerId], references: [id])

  @@map("team_balance_players")
}

/// Fila de jobs de sincronização de demos. O Hub é o produtor (cria PENDING);
/// o Worker é o consumidor (baixa demo, parseia, devolve resultado via /api/internal/ingest/match).
model SyncJob {
  id            String        @id @default(cuid())
  sourceMatchId String
  source        String        @default("gamersclub")
  downloadUrl   String
  status        SyncJobStatus @default(PENDING)
  sentAt        DateTime?
  completedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([sourceMatchId])
  @@map("sync_jobs")
}

model MatchPayload {
  id            String    @id @default(cuid())
  source        String
  sourceMatchId String
  parserVersion String
  schemaVersion String
  payload       Json
  payloadHash   String
  status        String    @default("STORED")
  processedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  revisions     IngestPayloadRevision[]

  @@unique([source, sourceMatchId])
  @@map("match_payloads")
}

model IngestPayloadRevision {
  id            String   @id @db.Uuid
  payloadId     String   @map("payload_id")
  payloadHash   String   @map("payload_hash")
  payload       Json
  parserVersion String   @map("parser_version")
  schemaVersion String   @map("schema_version")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  latest        MatchPayload @relation(fields: [payloadId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  jobs          NormalizationJob[]
  @@unique([payloadId, payloadHash])
  @@map("ingest_payload_revisions")
}

model NormalizationJob {
  id                String @id @db.Uuid
  revisionId        String @map("revision_id") @db.Uuid
  source            String
  sourceMatchId     String @map("source_match_id")
  normalizerVersion String @map("normalizer_version")
  status            String @default("PENDING")
  attempts          Int @default(0)
  maxAttempts       Int @default(5) @map("max_attempts")
  availableAt       DateTime @default(now()) @map("available_at") @db.Timestamp(3)
  leaseToken        String? @map("lease_token") @db.Uuid
  leaseUntil        DateTime? @map("lease_until") @db.Timestamp(3)
  owner             String?
  lastError         Json? @map("last_error")
  startedAt         DateTime? @map("started_at") @db.Timestamp(3)
  finishedAt        DateTime? @map("finished_at") @db.Timestamp(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamp(3)
  revision          IngestPayloadRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  attemptsLog       NormalizationAttempt[]
  projection        DemoMatchProjection?
  @@unique([revisionId, normalizerVersion])
  @@index([normalizerVersion, status, availableAt, leaseUntil], map: "normalization_jobs_claim")
  @@index([source, sourceMatchId], map: "normalization_jobs_match")
  @@index([status, leaseUntil], map: "normalization_jobs_lease")
  @@map("normalization_jobs")
}

model NormalizationAttempt {
  id         String @id @db.Uuid
  jobId      String @map("job_id") @db.Uuid
  leaseToken String @unique @map("lease_token") @db.Uuid
  attempt    Int
  owner      String
  startedAt  DateTime @default(now()) @map("started_at") @db.Timestamp(3)
  finishedAt DateTime? @map("finished_at") @db.Timestamp(3)
  outcome    String?
  error      Json?
  job        NormalizationJob @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([jobId, startedAt], map: "normalization_attempts_job")
  @@map("normalization_attempts")
}

model DemoMatchProjection {
  jobId             String @id @map("job_id") @db.Uuid
  matchId           String @map("match_id")
  normalizerVersion String @map("normalizer_version")
  normalized        Json
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamp(3)
  job               NormalizationJob @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  match             Match @relation(fields: [matchId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  @@index([matchId, createdAt], map: "demo_match_projections_match")
  @@map("demo_match_projections")
}

model PlayerMatchup {
  id          String   @id @default(cuid())
  matchId     String
  killerId    String
  victimId    String
  kills       Int      @default(0)
  headshots   Int      @default(0)
  entryKills  Int      @default(0)
  tradeKills  Int      @default(0)
  weapons     Json?
  rounds      Json?
  avgDistance Float?
  createdAt   DateTime @default(now())
  killer      Player   @relation("MatchupKiller", fields: [killerId], references: [id])
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  victim      Player   @relation("MatchupVictim", fields: [victimId], references: [id])

  @@unique([matchId, killerId, victimId])
  @@index([killerId, victimId])
  @@index([matchId])
}

model PlayerClutch {
  id          String    @id @default(cuid())
  matchId     String
  playerId    String
  opponents   Int
  won         Boolean
  roundNumber Int
  side        MatchTeam
  weapon      String?
  createdAt   DateTime  @default(now())
  match       Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player      Player    @relation(fields: [playerId], references: [id])

  @@index([matchId])
  @@index([playerId])
}

model PlayerEntryDuel {
  id          String    @id @default(cuid())
  matchId     String
  playerId    String
  isKiller    Boolean
  side        MatchTeam
  weapon      String?
  roundNumber Int
  opponentId  String?
  createdAt   DateTime  @default(now())
  match       Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player      Player    @relation(fields: [playerId], references: [id])

  @@index([matchId])
  @@index([playerId])
}

model PlayerTradeEvent {
  id          String   @id @default(cuid())
  matchId     String
  victimId    String
  traderId    String
  roundNumber Int
  timeDiff    Float
  weapon      String?
  createdAt   DateTime @default(now())
  match       Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  trader      Player   @relation("TradeTrader", fields: [traderId], references: [id])
  victim      Player   @relation("TradeVictim", fields: [victimId], references: [id])

  @@index([matchId])
  @@index([victimId])
  @@index([traderId])
}

enum MatchTeam {
  A
  B
}

enum EventType {
  KILL
  ACE
  CLUTCH_1V1
  CLUTCH_1V2
  CLUTCH_1V3
  CLUTCH_1V4
  CLUTCH_1V5
  MULTI_KILL_3
  MULTI_KILL_4
  MULTI_KILL_5
}

enum ImportStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
}

enum SeasonStatus {
  ACTIVE
  CLOSED
}

enum SyncJobStatus {
  PENDING
  SENT_TO_WORKER
  PROCESSING
  COMPLETED
  FAILED
}
