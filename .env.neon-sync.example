# Configuração do sync Neon (histórico) → DEV PostgreSQL local (Docker)
# Copie este arquivo para .env.neon-sync e preencha SOURCE_DATABASE_URL.
# .env.neon-sync está coberto por .env.* no .gitignore e NUNCA será commitado.
#
# Uso:
#   npm run db:sync-from-neon          → dry-run (somente comparação)
#   npm run db:sync-from-neon:import   → importação real

# URL de conexão do banco Neon histórico (obtenha no painel do Neon)
SOURCE_DATABASE_URL="postgresql://user:password@host/neondb?sslmode=require"
